{
  "name": "openrm-app",
  "version": "0.1.12",
  "private": true,
  "description": "OpenTask · 병렬 AI 개발 관제탑 — 여러 워크트리·에이전트를 한 화면에서 감시·지시",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "server": "node server/index.cjs",
    "dev": "vite",
    "start": "concurrently -n server,vite -c blue,green \"node server/index.cjs\" \"vite\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "postinstall": "patch-package && chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "electron:dev": "concurrently -n server,vite,electron -c blue,green,magenta \"node server/index.cjs\" \"vite\" \"ELECTRON_START_URL=http://localhost:5180 electron .\"",
    "electron:rebuild": "electron-rebuild -f -w better-sqlite3,node-pty",
    "electron:build": "tsc -b && vite build && electron-builder",
    "rebuild:node": "npm rebuild better-sqlite3 node-pty && chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "date-holidays": "^3.36.0",
    "electron-updater": "^6.8.9",
    "marked": "^18.0.11",
    "node-pty": "^1.1.0",
    "pg": "^8.22.0",
    "playwright": "^1.47.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "ws": "^8.21.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4",
    "@types/better-sqlite3": "^7.6.11",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26",
    "patch-package": "^8.0.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.6"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "build": {
    "appId": "com.opentask.desktop",
    "productName": "OpenTask",
    "icon": "build/icon.png",
    "asarUnpack": [
      "node_modules/**/*",
      "server/**/*",
      "dist/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "gatekeeperAssess": false
    },
    "afterSign": "build/afterSign.cjs",
    "afterAllArtifactBuild": "build/afterAllArtifactBuild.cjs",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jxxh204",
        "repo": "opentask"
      }
    ]
  }
}
